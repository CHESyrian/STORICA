/* ============================================================
   MODERN ERP THEME
   ============================================================ */

* {
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 13px;
    outline: none;
}


/* ============================================================
   MAIN WINDOW
   ============================================================ */

QMainWindow,
QWidget {
    background-color: #f5f7fa;
    color: #2d3748;
}


/* ============================================================
   LABELS
   ============================================================ */

QLabel {
    color: #2d3748;
    background: transparent;
}


/* ============================================================
   FRAMES
   ============================================================ */

QFrame {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}


/* ============================================================
   GROUP BOX
   ============================================================ */

QGroupBox {
    background: white;
    border: 1px solid #dce3eb;
    border-radius: 8px;
    margin-top: 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
}


/* ============================================================
   BUTTONS
   ============================================================ */

QPushButton {
    background-color: #2563eb;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
    min-height: 18px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #1d4ed8;
}

QPushButton:pressed {
    background-color: #1e40af;
}

QPushButton:disabled {
    background-color: #cbd5e1;
    color: #64748b;
}


/* Secondary Button */

QPushButton[secondary="true"] {
    background: white;
    color: #334155;
    border: 1px solid #cbd5e1;
}

QPushButton[secondary="true"]:hover {
    background: #f8fafc;
}


/* ============================================================
   INPUTS
   ============================================================ */

QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QDateTimeEdit,
QTimeEdit {
    background: white;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #2563eb;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QDateTimeEdit:focus,
QTimeEdit:focus {
    border: 2px solid #2563eb;
}


/* ============================================================
   COMBO BOX
   ============================================================ */

QComboBox {
    background: white;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 8px;
    min-height: 22px;
}

QComboBox:hover {
    border-color: #94a3b8;
}

QComboBox:focus {
    border: 2px solid #2563eb;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background: white;
    border: 1px solid #cbd5e1;
    selection-background-color: #2563eb;
    selection-color: white;
}


/* ============================================================
   TABLES
   ============================================================ */

QTableView,
QTreeView {
    background: white;
    alternate-background-color: #f8fafc;
    border: 1px solid #dce3eb;
    border-radius: 8px;
    gridline-color: #edf2f7;
    selection-background-color: #dbeafe;
    selection-color: #1e293b;
}

QTableView::item,
QTreeView::item {
    padding: 6px;
}

QHeaderView::section {
    background-color: #f1f5f9;
    color: #334155;
    border: none;
    border-bottom: 1px solid #dce3eb;
    border-right: 1px solid #e2e8f0;
    padding: 8px;
    font-weight: 600;
}


/* ============================================================
   LISTS
   ============================================================ */

QListWidget {
    background: white;
    border: 1px solid #dce3eb;
    border-radius: 8px;
}

QListWidget::item {
    padding: 8px;
}

QListWidget::item:selected {
    background: #2563eb;
    color: white;
}


/* ============================================================
   TAB WIDGET
   ============================================================ */

QTabWidget::pane {
    border: 1px solid #dce3eb;
    background: white;
}

QTabBar::tab {
    background: #f1f5f9;
    padding: 8px 14px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: white;
    border-bottom: 2px solid #2563eb;
}


/* ============================================================
   MENU
   ============================================================ */

QMenuBar {
    background: white;
    border-bottom: 1px solid #e2e8f0;
}

QMenuBar::item {
    padding: 6px 10px;
}

QMenuBar::item:selected {
    background: #e2e8f0;
}

QMenu {
    background: white;
    border: 1px solid #dce3eb;
}

QMenu::item {
    padding: 8px 20px;
}

QMenu::item:selected {
    background: #2563eb;
    color: white;
}


/* ============================================================
   TOOLBAR
   ============================================================ */

QToolBar {
    background: white;
    border-bottom: 1px solid #e2e8f0;
    spacing: 4px;
}


/* ============================================================
   STATUS BAR
   ============================================================ */

QStatusBar {
    background: white;
    border-top: 1px solid #e2e8f0;
}


/* ============================================================
   CHECKBOX
   ============================================================ */

QCheckBox {
    spacing: 6px;
}


/* ============================================================
   SCROLL BAR
   ============================================================ */

QScrollBar:vertical {
    width: 12px;
    background: transparent;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 6px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar:horizontal {
    height: 12px;
    background: transparent;
}

QScrollBar::handle:horizontal {
    background: #cbd5e1;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    border: none;
    background: none;
}


/* ============================================================
   SPLITTER
   ============================================================ */

QSplitter::handle {
    background: #e2e8f0;
}

QSplitter::handle:hover {
    background: #cbd5e1;
}


/* ============================================================
   LOGIN CARD
   ============================================================ */

QWidget#LoginCard {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}


/* ============================================================
   SIDEBAR
   ============================================================ */

QFrame#Sidebar {
    background: #1e293b;
    border: none;
}

QFrame#Sidebar QLabel {
    color: white;
}

QFrame#Sidebar QListWidget {
    background: transparent;
    border: none;
}

QFrame#Sidebar QListWidget::item {
    color: #cbd5e1;
    border-radius: 6px;
    padding: 10px;
    margin: 2px 6px;
}

QFrame#Sidebar QListWidget::item:selected {
    background: #2563eb;
    color: white;
}

QFrame#Sidebar QListWidget::item:hover {
    background: #334155;
}


/* ============================================================
   DIALOGS
   ============================================================ */

QDialog {
    background: #f8fafc;
}

/* ==========================================================
   PANEL PAGE
   ========================================================== */

QLabel#panelSectionLabel {
    font-size: 16px;
    font-weight: bold;
    color: #475569;
    background: transparent;
    border: none;
}

QWidget#panelSeparator {
    background-color: #cbd5e1;
    border: none;
    max-height: 2px;
    min-height: 2px;
}

QWidget#panel_page {
    background: transparent;
}


/* ==========================================================
   REPORT TABS
   ========================================================== */

QWidget#reportPage,
QWidget#reportContent {
    background: transparent;
}

QScrollArea#reportScroll {
    background: transparent;
    border: none;
}

QLabel#reportHeading {
    font-size: 18px;
    font-weight: 600;
    color: #1e293b;
    background: transparent;
    border: none;
}

QLabel#reportSectionLabel {
    font-size: 13px;
    font-weight: 600;
    color: #64748b;
    background: transparent;
    border: none;
    margin-top: 4px;
}

QLabel#reportBlurb,
QLabel#reportHint,
QLabel#reportDetailLabel {
    background: transparent;
    border: none;
    color: #64748b;
}

QLabel#reportStatCaption {
    background: transparent;
    border: none;
    font-size: 12px;
    color: #64748b;
}

QLabel#reportStatValue {
    font-size: 20px;
    font-weight: 700;
    background: transparent;
    border: none;
    color: #0f172a;
}

QFrame#reportStatCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}

QFrame#reportStatCard:hover {
    border-color: #2563eb;
}

QTextEdit#reportSummaryBody,
QTextEdit#reportConclusionBody,
QTextEdit#reportBody {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px;
    color: #1e293b;
}



/* ==========================================================
   LOADING OVERLAY
   ========================================================== */

QWidget#LoadingOverlay {
    background-color: rgba(0, 0, 0, 120);
    border: none;
}

QLabel#LoadingOverlayLabel {
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
    border: none;
}


/* ==========================================================
   TOASTS
   ========================================================== */

Toast,
QFrame#Toast {
    border-radius: 8px;
    background-color: #1E3A8A;
    border: 1px solid #3B82F6;
}

Toast[toastType="success"],
QFrame#Toast[toastType="success"] {
    background-color: #064E3B;
    border: 1px solid #10B981;
}

Toast[toastType="error"],
QFrame#Toast[toastType="error"] {
    background-color: #7F1D1D;
    border: 1px solid #EF4444;
}

Toast[toastType="warning"],
QFrame#Toast[toastType="warning"] {
    background-color: #78350F;
    border: 1px solid #F59E0B;
}

Toast[toastType="info"],
QFrame#Toast[toastType="info"] {
    background-color: #1E3A8A;
    border: 1px solid #3B82F6;
}

QLabel#ToastMessage {
    color: #F1F5F9;
    background: transparent;
    border: none;
}

QLabel#ToastIcon {
    font-size: 14px;
    font-weight: bold;
    background: transparent;
    border: none;
    color: #3B82F6;
}

QLabel#ToastIcon[toastType="success"] { color: #10B981; }
QLabel#ToastIcon[toastType="error"]   { color: #EF4444; }
QLabel#ToastIcon[toastType="warning"] { color: #F59E0B; }
QLabel#ToastIcon[toastType="info"]    { color: #3B82F6; }

QLabel#ToastClose {
    color: #94A3B8;
    border-radius: 10px;
    padding: 2px;
    background: transparent;
}

QLabel#ToastClose:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #F1F5F9;
}


/* ==========================================================
   STATUS LABELS (dialogs / detail views)
   ========================================================== */

QLabel#statusLabel {
    font-weight: 600;
    background: transparent;
    border: none;
}

QLabel#statusLabel[status="draft"],
QLabel#statusLabel[status="pending"] {
    color: #c8c800;
}

QLabel#statusLabel[status="processing"],
QLabel#statusLabel[status="sent"],
QLabel#statusLabel[status="shipped"],
QLabel#statusLabel[status="maintenance"] {
    color: #ffa500;
}

QLabel#statusLabel[status="active"],
QLabel#statusLabel[status="confirmed"],
QLabel#statusLabel[status="completed"],
QLabel#statusLabel[status="paid"],
QLabel#statusLabel[status="delivered"] {
    color: #00c800;
}

QLabel#statusLabel[status="partial"],
QLabel#statusLabel[status="partial_paid"] {
    color: #ffc800;
}

QLabel#statusLabel[status="posted"] {
    color: #007800;
}

QLabel#statusLabel[status="overdue"],
QLabel#statusLabel[status="expired"],
QLabel#statusLabel[status="recalled"] {
    color: #ff6400;
}

QLabel#statusLabel[status="sold_out"] {
    color: #c86400;
}

QLabel#statusLabel[status="cancelled"],
QLabel#statusLabel[status="failed"],
QLabel#statusLabel[status="refunded"],
QLabel#statusLabel[status="inactive"] {
    color: #b40000;
}

MsgModernButton:disabled {
    background-color: #CBD5E1;
    color: #64748B;
}



/* report styles defined in REPORT TABS section above */

