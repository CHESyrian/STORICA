/* =========================================================
        PYQT6 AURORA GLASS THEME
   ========================================================= */

/* =========================================================
   GLOBAL
   ========================================================= */

* {
    font-family: "Segoe UI";
    font-size: 13px;
    color: #edf4ff;
    outline: none;
}


/* =========================================================
   ROOT WINDOWS
   ========================================================= */

QMainWindow,
QDialog,
QWidget {
    background-color: #0a0f1f;
}


/* =========================================================
   STACKED WIDGET
   ========================================================= */

QStackedWidget {
    background-color: transparent;
    border: none;
}

QStackedWidget > QWidget {
    background-color: transparent;
}


/* =========================================================
   GLASS PANELS / FRAMES
   ========================================================= */

QFrame,
QGroupBox {
    background: rgba(20, 28, 48, 0.88);

    border: 1px solid rgba(90, 120, 255, 0.35);

    border-radius: 18px;
}

QGroupBox {
    margin-top: 18px;
    padding-top: 18px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 10px;

    color: #7dd3fc;
}


/* =========================================================
   LABELS
   ========================================================= */

QLabel {
    background: transparent;
    color: #e6f0ff;
}


/* =========================================================
   INPUTS
   ========================================================= */

QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit,
QComboBox {
    background: rgba(15, 23, 42, 0.92);

    border: 1px solid rgba(100, 149, 237, 0.35);

    border-radius: 12px;

    padding: 10px 14px;

    color: white;

    selection-background-color: #7c3aed;
    selection-color: white;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QComboBox:hover,
QSpinBox:hover {
    border: 1px solid #38bdf8;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #7c3aed;

    background: rgba(20, 30, 54, 0.95);
}


/* =========================================================
   COMBOBOX
   ========================================================= */

QComboBox {
    padding-right: 30px;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
    background: transparent;
}

QComboBox QAbstractItemView {
    background: rgba(18, 25, 44, 0.98);

    border: 1px solid rgba(124, 58, 237, 0.4);

    border-radius: 10px;

    padding: 6px;

    selection-background-color: #7c3aed;

    color: white;
}


/* =========================================================
   BUTTONS
   ========================================================= */

QPushButton {
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:1,
        stop:0 #06b6d4,
        stop:0.5 #3b82f6,
        stop:1 #7c3aed
    );

    border: 1px solid rgba(255,255,255,0.08);

    border-radius: 14px;

    padding: 10px 22px;

    color: white;

    font-weight: 700;
}

QPushButton:hover {
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:1,
        stop:0 #22d3ee,
        stop:0.5 #60a5fa,
        stop:1 #8b5cf6
    );
}

QPushButton:pressed {
    background-color: #5b21b6;
}

QPushButton:disabled {
    background-color: #334155;
    color: #94a3b8;
}


/* =========================================================
   TABLES
   ========================================================= */

QTableView,
QTableWidget {
    background: rgba(16, 24, 44, 0.94);

    alternate-background-color: rgba(22, 32, 58, 0.96);

    border: 1px solid rgba(99, 102, 241, 0.35);

    border-radius: 12px;

    gridline-color: rgba(99, 102, 241, 0.18);

    selection-background-color: #7c3aed;

    selection-color: white;

    padding: 6px;
}

QTableView::item,
QTableWidget::item {
    padding: 4px;
    border: none;
}

QTableView::item:selected,
QTableWidget::item:selected {
    background-color: #7c3aed;
    color: white;
}


/* =========================================================
   HEADERS
   ========================================================= */

QHeaderView {
    background: transparent;
}

QHeaderView::section {
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 rgba(14,165,233,0.85),
        stop:1 rgba(124,58,237,0.85)
    );

    padding: 12px;

    border: none;

    color: white;

    font-weight: bold;
}

QTableCornerButton::section {
    background-color: #1e293b;
    border: none;
}


/* =========================================================
   LISTS / TREES
   ========================================================= */

QListWidget,
QTreeWidget,
QListView,
QTreeView {
    background: rgba(16, 24, 44, 0.94);

    border: 1px solid rgba(99, 102, 241, 0.35);

    border-radius: 16px;

    padding: 6px;

    outline: none;
}

QListWidget::item,
QTreeWidget::item {
    padding: 10px;

    margin: 2px;

    border-radius: 10px;
}

QListWidget::item:hover,
QTreeWidget::item:hover {
    background: rgba(59, 130, 246, 0.25);
}

QListWidget::item:selected,
QTreeWidget::item:selected {
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 #06b6d4,
        stop:1 #7c3aed
    );

    color: white;
}


/* =========================================================
   TAB WIDGET
   ========================================================= */

QTabWidget {
    background: transparent;
}

QTabWidget::pane {
    border: 1px solid rgba(99, 102, 241, 0.35);

    background: rgba(15, 23, 42, 0.92);

    border-radius: 16px;

    padding: 12px;

    top: -1px;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: rgba(25, 35, 58, 0.92);

    color: #cbd5e1;

    padding: 12px 26px;

    margin-right: 6px;

    border-top-left-radius: 14px;
    border-top-right-radius: 14px;

    min-width: 110px;

    font-weight: 600;
}

QTabBar::tab:hover {
    background: rgba(59, 130, 246, 0.28);
}

QTabBar::tab:selected {
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 #06b6d4,
        stop:1 #7c3aed
    );

    color: white;
}


/* =========================================================
   SCROLL AREA
   ========================================================= */

QScrollArea {
    border: none;
    background: transparent;
}


/* =========================================================
   SCROLLBARS
   ========================================================= */

QScrollBar:vertical {
    background: transparent;

    width: 12px;

    margin: 2px;
}

QScrollBar::handle:vertical {
    background: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #06b6d4,
        stop:1 #7c3aed
    );

    border-radius: 6px;

    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #8b5cf6;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;

    height: 12px;
}

QScrollBar::handle:horizontal {
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 #06b6d4,
        stop:1 #7c3aed
    );

    border-radius: 6px;

    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #8b5cf6;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}


/* =========================================================
   MENUS
   ========================================================= */

QMenuBar {
    background: rgba(10, 15, 31, 0.95);
}

QMenuBar::item {
    padding: 6px 12px;
    background: transparent;
}

QMenuBar::item:selected {
    background: rgba(124, 58, 237, 0.4);

    border-radius: 6px;
}

QMenu {
    background: rgba(15, 23, 42, 0.96);

    border: 1px solid rgba(124, 58, 237, 0.35);

    border-radius: 12px;

    padding: 6px;
}

QMenu::item {
    padding: 8px 20px;

    border-radius: 8px;
}

QMenu::item:selected {
    background: rgba(124, 58, 237, 0.4);
}


/* =========================================================
   TOOLBAR
   ========================================================= */

QToolBar {
    background: rgba(10, 15, 31, 0.95);

    border: none;

    spacing: 8px;

    padding: 6px;
}

QToolButton {
    background: transparent;

    border-radius: 10px;

    padding: 8px;
}

QToolButton:hover {
    background: rgba(59, 130, 246, 0.22);
}


/* =========================================================
   STATUS BAR
   ========================================================= */

QStatusBar {
    background: rgba(10, 15, 31, 0.95);

    color: #cbd5e1;
}


/* =========================================================
   CHECKBOX / RADIO
   ========================================================= */

QCheckBox,
QRadioButton {
    spacing: 8px;

    color: #f1f5f9;
}


/* =========================================================
   PROGRESS BAR
   ========================================================= */

QProgressBar {
    background: rgba(20, 28, 48, 0.95);

    border-radius: 10px;

    text-align: center;

    border: none;

    color: white;
}

QProgressBar::chunk {
    background: qlineargradient(
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 #06b6d4,
        stop:1 #7c3aed
    );

    border-radius: 10px;
}


/* =========================================================
   SLIDER
   ========================================================= */

QSlider::groove:horizontal {
    height: 6px;

    background: rgba(99, 102, 241, 0.25);

    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #7c3aed;

    width: 18px;

    margin: -6px 0;

    border-radius: 9px;
}


/* =========================================================
   SPLITTER
   ========================================================= */

QSplitter::handle {
    background: rgba(99, 102, 241, 0.25);
}

QSplitter::handle:hover {
    background: #7c3aed;
}


/* =========================================================
   TOOLTIP
   ========================================================= */

QToolTip {
    background: rgba(15, 23, 42, 0.98);

    color: white;

    border: 1px solid #7c3aed;

    padding: 8px;

    border-radius: 8px;
}

/* ==========================================================
   PANEL PAGE
   ========================================================== */

QLabel#panelSectionLabel {
    font-size: 16px;
    font-weight: bold;
    color: #7dd3fc;
    background: transparent;
    border: none;
}

QWidget#panelSeparator {
    background-color: rgba(90, 120, 255, 0.35);
    border: none;
    max-height: 2px;
    min-height: 2px;
}

QWidget#panel_page {
    background: transparent;
}


/* ==========================================================
   REPORT TABS
   ========================================================== */

QWidget#reportPage,
QWidget#reportContent {
    background: transparent;
}

QScrollArea#reportScroll {
    background: transparent;
    border: none;
}

QLabel#reportHeading {
    font-size: 18px;
    font-weight: 600;
    color: #e6f0ff;
    background: transparent;
    border: none;
}

QLabel#reportSectionLabel {
    font-size: 13px;
    font-weight: 600;
    color: #7dd3fc;
    background: transparent;
    border: none;
    margin-top: 4px;
}

QLabel#reportBlurb,
QLabel#reportHint,
QLabel#reportDetailLabel {
    background: transparent;
    border: none;
    color: #94a3b8;
}

QLabel#reportStatCaption {
    background: transparent;
    border: none;
    font-size: 12px;
    color: #94a3b8;
}

QLabel#reportStatValue {
    font-size: 20px;
    font-weight: 700;
    background: transparent;
    border: none;
    color: #e6f0ff;
}

QFrame#reportStatCard {
    background-color: rgba(20, 28, 48, 0.92);
    border: 1px solid rgba(90, 120, 255, 0.35);
    border-radius: 12px;
}

QFrame#reportStatCard:hover {
    border-color: #7dd3fc;
}

QTextEdit#reportSummaryBody,
QTextEdit#reportConclusionBody,
QTextEdit#reportBody {
    background-color: rgba(20, 28, 48, 0.75);
    border: 1px solid rgba(90, 120, 255, 0.30);
    border-radius: 10px;
    padding: 8px;
    color: #e6f0ff;
}



/* ==========================================================
   LOADING OVERLAY
   ========================================================== */

QWidget#LoadingOverlay {
    background-color: rgba(0, 0, 0, 120);
    border: none;
}

QLabel#LoadingOverlayLabel {
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
    border: none;
}


/* ==========================================================
   TOASTS
   ========================================================== */

Toast,
QFrame#Toast {
    border-radius: 8px;
    background-color: #1E3A8A;
    border: 1px solid #3B82F6;
}

Toast[toastType="success"],
QFrame#Toast[toastType="success"] {
    background-color: #064E3B;
    border: 1px solid #10B981;
}

Toast[toastType="error"],
QFrame#Toast[toastType="error"] {
    background-color: #7F1D1D;
    border: 1px solid #EF4444;
}

Toast[toastType="warning"],
QFrame#Toast[toastType="warning"] {
    background-color: #78350F;
    border: 1px solid #F59E0B;
}

Toast[toastType="info"],
QFrame#Toast[toastType="info"] {
    background-color: #1E3A8A;
    border: 1px solid #3B82F6;
}

QLabel#ToastMessage {
    color: #F1F5F9;
    background: transparent;
    border: none;
}

QLabel#ToastIcon {
    font-size: 14px;
    font-weight: bold;
    background: transparent;
    border: none;
    color: #3B82F6;
}

QLabel#ToastIcon[toastType="success"] { color: #10B981; }
QLabel#ToastIcon[toastType="error"]   { color: #EF4444; }
QLabel#ToastIcon[toastType="warning"] { color: #F59E0B; }
QLabel#ToastIcon[toastType="info"]    { color: #3B82F6; }

QLabel#ToastClose {
    color: #94A3B8;
    border-radius: 10px;
    padding: 2px;
    background: transparent;
}

QLabel#ToastClose:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #F1F5F9;
}


/* ==========================================================
   STATUS LABELS (dialogs / detail views)
   ========================================================== */

QLabel#statusLabel {
    font-weight: 600;
    background: transparent;
    border: none;
}

QLabel#statusLabel[status="draft"],
QLabel#statusLabel[status="pending"] {
    color: #c8c800;
}

QLabel#statusLabel[status="processing"],
QLabel#statusLabel[status="sent"],
QLabel#statusLabel[status="shipped"],
QLabel#statusLabel[status="maintenance"] {
    color: #ffa500;
}

QLabel#statusLabel[status="active"],
QLabel#statusLabel[status="confirmed"],
QLabel#statusLabel[status="completed"],
QLabel#statusLabel[status="paid"],
QLabel#statusLabel[status="delivered"] {
    color: #00c800;
}

QLabel#statusLabel[status="partial"],
QLabel#statusLabel[status="partial_paid"] {
    color: #ffc800;
}

QLabel#statusLabel[status="posted"] {
    color: #007800;
}

QLabel#statusLabel[status="overdue"],
QLabel#statusLabel[status="expired"],
QLabel#statusLabel[status="recalled"] {
    color: #ff6400;
}

QLabel#statusLabel[status="sold_out"] {
    color: #c86400;
}

QLabel#statusLabel[status="cancelled"],
QLabel#statusLabel[status="failed"],
QLabel#statusLabel[status="refunded"],
QLabel#statusLabel[status="inactive"] {
    color: #b40000;
}

MsgModernButton:disabled {
    background-color: #CBD5E1;
    color: #64748B;
}



/* report styles defined in REPORT TABS section above */

